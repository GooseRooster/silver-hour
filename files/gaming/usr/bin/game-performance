#!/usr/bin/bash
# game-performance — run a command under the gaming power profile.
#
# While the wrapped command runs it switches TuneD to `latency-performance`
# and restores the previously active profile on exit. Idle/suspend inhibition
# is left to the Caffeine Shell extension, which activates automatically while
# a fullscreen application is running.
#
# Profiles are switched through tuned-adm. tuned-ppd only exposes the
# power-profiles-daemon D-Bus API (there is no powerprofilesctl on this image),
# and tuned-adm profile switching is authorised for the active local session
# (polkit com.redhat.tuned.switch_profile, allow_active=yes).
#
# Usage: game-performance [--] <command> [args...]
set -euo pipefail

usage() { echo "usage: game-performance [--] <command> [args...]" >&2; }

[ "$#" -ge 1 ] || { usage; exit 2; }
[ "${1:-}" = "--" ] && shift
[ "$#" -ge 1 ] || { usage; exit 2; }

GAMING_PROFILE="latency-performance"

NOTIFY="$(command -v notify-send || true)"
notify() { [ -n "$NOTIFY" ] && "$NOTIFY" -a "Game performance" "$@" >/dev/null 2>&1 || true; }

# Save the active profile so it can be restored afterwards.
saved_profile="$(tuned-adm active 2>/dev/null | sed -n 's/^Current active profile: *//p' || true)"
[ -n "$saved_profile" ] || saved_profile="balanced"

restore() {
  trap - EXIT
  tuned-adm profile "$saved_profile" >/dev/null 2>&1 || true
  notify "Restored profile: $saved_profile"
}
trap restore EXIT

tuned-adm profile "$GAMING_PROFILE" >/dev/null 2>&1
notify "Gaming mode: $*"

"$@"
