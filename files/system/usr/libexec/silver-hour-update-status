#!/usr/bin/bash
# Record the bootc deployment / update state for the user-facing notifier and
# the tray indicator.
#
# `bootc status` refuses unprivileged users, so this runs as root from
# silver-hour-update-status.service and writes a world-readable JSON file to
# /run/silver-hour/update-status.json.
#
# `bootc upgrade --check` fetches the upstream manifest (metadata only) and, when
# a newer image exists, records it as `cachedUpdate` on the booted deployment.
# Both `booted.imageDigest` and `cachedUpdate.imageDigest` are platform-manifest
# digests from bootc, so they can be compared directly. (Do not compare them
# against `skopeo inspect --format '{{.Digest}}'`: for a multi-manifest image
# that reports the *manifest-list/index* digest, a different object that never
# matches the platform digest bootc stores.)
#
# Usage:
#   silver-hour-update-status           full check: remote manifest + local status
#   silver-hour-update-status --local   local status only, no network access
#
# The remote half costs a few seconds and a manifest fetch, so it only runs in
# the full mode. The local half is a read-only lookup and runs far more often
# (silver-hour-update-status-local.timer). In --local mode there is no remote
# information, so `availableDigest`/`updateAvailable` are carried over from the
# previous status file instead of being recomputed; that keeps the "update
# available" state stable between the (much rarer) remote checks.
#
# Output schema:
#   staged           bool   a deployment is queued for the next boot
#   stagedVersion    string | null
#   stagedDigest     string | null
#   bootedVersion    string | null
#   bootedDigest     string | null
#   availableDigest  string | null  digest of the cached newer image (not staged)
#   updateAvailable  bool   a newer image is cached by bootc or is staged
#   checkedAt        int    unix seconds
set -euo pipefail

LOCAL_ONLY=0
case "${1:-}" in
  "") ;;
  --local) LOCAL_ONLY=1 ;;
  *)
    echo "usage: $0 [--local]" >&2
    exit 2
    ;;
esac

OUT="/run/silver-hour/update-status.json"
STATUS_TMP="$(mktemp)"

cleanup() { rm -f "$STATUS_TMP"; }
trap cleanup EXIT

# Refresh the upstream manifest (metadata only; safe to run in a timer). When a
# newer image exists bootc records it as `booted.cachedUpdate`; when there is
# nothing new it leaves the field null. Skipped in --local mode: the fetch
# costs seconds and writes to the image store, and the local check runs every
# few minutes.
if [ "$LOCAL_ONLY" -eq 0 ]; then
  bootc upgrade --check >/dev/null 2>&1 || true
fi

if ! bootc status --json --format-version=1 >"$STATUS_TMP" 2>/dev/null; then
  exit 0
fi

mkdir -p /run/silver-hour

# Previous status, read as late as possible so a concurrent full check is not
# overwritten with older values.
prev='{}'
if [ -r "$OUT" ]; then
  prev="$(cat "$OUT" 2>/dev/null || echo '{}')"
  if ! printf '%s' "$prev" | jq -e . >/dev/null 2>&1; then
    prev='{}'
  fi
fi

tmp_out="$(mktemp "/run/silver-hour/.update-status.XXXXXX")"
# bootc host API v1 (org.containers.bootc/v1): a BootEntry has an `image`
# (ImageStatus), which carries `version`/`imageDigest` directly; `cachedUpdate`
# is an ImageStatus too. All optional access uses `?` so an unexpected shape
# yields null rather than aborting the service.
#
# A cached update only counts as available when its digest differs from the
# booted image. `bootc upgrade --check` can leave a cached entry whose digest
# equals the booted one, and bootc's own renderer hides those for the same
# reason.
jq -c --argjson local "$LOCAL_ONLY" --argjson prev "$prev" '
  (.status.staged != null) as $staged
  | (.status.staged.image.version? // null) as $stagedVersion
  | (.status.staged.image.imageDigest? // null) as $stagedDigest
  | (.status.booted.image.version? // null) as $bootedVersion
  | (.status.booted.image.imageDigest? // null) as $bootedDigest
  | (.status.booted.cachedUpdate.imageDigest? // .status.booted.cachedUpdate.image?.imageDigest? // null) as $cachedDigest
  | (($cachedDigest != null) and ($cachedDigest != $bootedDigest)) as $cachedNewer
  | (if $cachedNewer
     then $cachedDigest
     elif ($local == 1)
          and (($prev.availableDigest? // null) != null)
          and ($prev.availableDigest != $bootedDigest)
     then $prev.availableDigest
     else null
     end) as $availableDigest
  | {
      staged: $staged,
      stagedVersion: $stagedVersion,
      stagedDigest: $stagedDigest,
      bootedVersion: $bootedVersion,
      bootedDigest: $bootedDigest,
      availableDigest: $availableDigest,
      updateAvailable: ($staged or ($availableDigest != null)),
      checkedAt: (now | floor)
    }
  ' "$STATUS_TMP" >"$tmp_out"

chmod 0644 "$tmp_out"
mv -f "$tmp_out" "$OUT"
