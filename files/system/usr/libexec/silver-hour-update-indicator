#!/usr/bin/python3
# silver-hour update tray indicator.
#
# An AppIndicator/KStatusNotifierItem (shown by the appindicator GNOME Shell
# extension) that reflects the bootc update status written by
# silver-hour-update-status.service. It gives the "update available / ready to
# apply" state a persistent, GNOME-native home in the status tray.
#
# The icon changes so the state is visible at a glance:
#   * up to date -> a checkmark
#   * available  -> the "update available" icon
#   * staged     -> the "urgent update" icon, with the indicator attention state
#
# Whether a deployment is staged is detected with an unprivileged ostree probe
# (silver-hour-staged-deployment) rather than with the status file alone, so a
# staged deployment shows up within seconds of it being queued - no matter
# whether topgrade, a manual `sudo bootc upgrade` or the automatic updater
# staged it. The status file remains the source for the upstream availability
# check and for the version of the staged update.
import json
import subprocess

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

try:
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
except (ValueError, ImportError):
    gi.require_version("AppIndicator3", "0.1")
    from gi.repository import AppIndicator3 as AppIndicator  # noqa: E402


STATUS_FILE = "/run/silver-hour/update-status.json"
STAGED_HELPER = "/usr/libexec/silver-hour-staged-deployment"
NOTIFY_SERVICE = "silver-hour-update-notify.service"
POLL_SECONDS = 20
APP_ID = "silver-hour-update"

ICON_STAGED = "software-update-urgent-symbolic"
ICON_AVAILABLE = "software-update-available-symbolic"
ICON_CURRENT = "object-select-symbolic"


def read_status():
    try:
        with open(STATUS_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def staged_deployment():
    """Checksum of the staged deployment, or "" when nothing is staged.

    The helper shells out to `ostree admin status --json`, which works
    unprivileged and costs a few milliseconds.
    """
    try:
        proc = subprocess.run(
            [STAGED_HELPER],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return proc.stdout.strip()


def update_state(status, staged_checksum):
    """Icon, label and staged flag for the current update state.

    A staged deployment is authoritative: the probe detects it even before the
    root status file has been refreshed. The status file provides the version
    of the staged update once it has caught up.
    """
    staged = status.get("staged") is True or bool(staged_checksum)
    available = status.get("updateAvailable") is True
    version = status.get("stagedVersion") or ""

    if staged:
        icon = ICON_STAGED
        if version:
            label = f"Update {version} ready — restart to apply".replace("  ", " ")
        else:
            label = "Update ready — restart to apply"
    elif available:
        icon = ICON_AVAILABLE
        label = "Update available — run topgrade"
    else:
        icon = ICON_CURRENT
        label = "silver-hour is up to date"

    return {"staged": staged, "icon": icon, "label": label}


class Indicator:
    def __init__(self):
        self.indicator = AppIndicator.Indicator.new(
            APP_ID,
            ICON_CURRENT,
            AppIndicator.IndicatorCategory.SYSTEM_SERVICES,
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("silver-hour updates")
        self.indicator.set_menu(self._build_menu())
        self.last_staged = ""
        self.refresh()
        GLib.timeout_add_seconds(POLL_SECONDS, self._tick)

    def _build_menu(self):
        menu = Gtk.Menu()

        self.item_status = Gtk.MenuItem(label="Checking…")
        self.item_status.set_sensitive(False)
        menu.append(self.item_status)
        menu.append(Gtk.SeparatorMenuItem())

        topgrade = Gtk.MenuItem(label="Run updates (topgrade)")
        topgrade.connect("activate", self._run, "silver-hour-topgrade")
        menu.append(topgrade)

        self.item_restart = Gtk.MenuItem(label="Restart to apply")
        self.item_restart.connect("activate", self._run, "systemctl reboot")
        menu.append(self.item_restart)

        menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", Gtk.main_quit)
        menu.append(quit_item)

        menu.show_all()
        return menu

    @staticmethod
    def _run(_item, command):
        subprocess.Popen(["/usr/bin/bash", "-lc", command], start_new_session=True)

    @staticmethod
    def _notify_staged():
        """Ask the per-user notifier to announce a newly staged deployment.

        The notifier deduplicates on the deployment checksum, so this only
        results in a notification for a deployment that has not been announced
        yet.
        """
        try:
            subprocess.Popen(
                ["systemctl", "--user", "start", NOTIFY_SERVICE],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            pass

    def _tick(self):
        self.refresh()
        return True

    def refresh(self):
        status = read_status()
        staged_checksum = staged_deployment()
        state = update_state(status, staged_checksum)

        if state["staged"]:
            indicator_status = AppIndicator.IndicatorStatus.ATTENTION
        else:
            indicator_status = AppIndicator.IndicatorStatus.ACTIVE

        self.indicator.set_status(indicator_status)
        self.indicator.set_icon_full(state["icon"], state["label"])
        self.item_status.set_label(state["label"])
        self.item_restart.set_visible(state["staged"])

        if staged_checksum and staged_checksum != self.last_staged:
            self.last_staged = staged_checksum
            self._notify_staged()

    def run(self):
        Gtk.main()


def main():
    Indicator().run()


if __name__ == "__main__":
    main()
