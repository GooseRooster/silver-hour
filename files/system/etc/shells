# /etc/shells: valid login shells.
# Fedora's `setup` package ships only sh/bash; zsh is added by the image as the
# login shell. This MUST list zsh: AccountsService classifies an account whose
# shell is absent here as a system account, and GDM then refuses to show/start
# it (which breaks first-time setup). See
# files/system/usr/libexec/silver-hour-set-login-shell and the build-time
# assertion in recipes/common.yml.
/bin/sh
/bin/bash
/usr/bin/sh
/usr/bin/bash
/usr/bin/zsh
