# Defaults for useradd.
#
# SHELL is set to zsh so users created by the installer (or by
# bootc-image-builder for local testing) get the silver-hour login shell from
# creation. silver-hour-set-login-shell.service still re-applies it on boot for
# any account that was created on bash.
GROUP=100
HOME=/home
INACTIVE=-1
EXPIRE=
SHELL=/usr/bin/zsh
SKEL=/etc/skel
CREATE_MAIL_SPOOL=yes
