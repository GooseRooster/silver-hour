{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned bazaar-companion source revision",
      "managerFilePatterns": [
        "/^files/scripts/install-bazaar-companion\\.sh$/"
      ],
      "matchStrings": [
        "REF=\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "bazaar-companion",
      "packageNameTemplate": "https://github.com/bazaar-org/bazaar-companion",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Bump the pinned BlueBuild CLI version",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "cli_version:\\s*['\"]?(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "blue-build/cli",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "github-actions"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "blue-build/cli"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/",
      "minimumReleaseAge": "1 day",
      "pinDigests": false,
      "groupName": "bluebuild"
    }
  ]
}
